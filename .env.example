# WorldQuant BRAIN Platform
BRAIN_EMAIL=your_email@example.com
BRAIN_PASSWORD=your_password_here

# HF Submission Queue Server (deploy your own from server/; see docs)
HF_SERVER_URL=https://your-user-brain-submission-queue.hf.space
HF_API_KEY=your_api_key_here
HF_TOKEN=your_hf_token_here
# HuggingFace Space id, used by scripts/server_watchdog.py to restart the Space
SPACE_ID=your-user/brain-submission-queue

# LLM Provider (optional -- used by paper ingestion pipeline)
LLM_MODEL=openai/gpt-4o
LLM_API_KEY=

# Storage (SQLite, used by the orchestrator CLI and paper pipeline;
# the agent mining loop persists to markdown under data/ instead)
DB_PATH=data/alpha_mining.db

# Datalab (Marker) Document Parsing
DATALAB_API_KEY=

# BRAIN Concurrency
MAX_CONCURRENT_SIMS=3
DAILY_SIM_BUDGET=5000

# Notifications (optional -- used by the cloud automation email digest)
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# Cursor API key (optional -- used by scripts/audit_cloud_trace.py to pull agent traces)
CURSOR_API_KEY=
